{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "rxdb": [
        "./node_modules/rxdb"
      ],
      "rxdb/*": [
        "./node_modules/rxdb/*"
      ],
      "fractional-indexing": [
        "./node_modules/fractional-indexing"
      ],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "simple-peer": [
        "./node_modules/@types/simple-peer"
      ],
      "fflate": [
        "./node_modules/fflate"
      ],
      "rxjs": [
        "./node_modules/rxjs"
      ],
      "rxjs/*": [
        "./node_modules/rxjs/*"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "capacitor.config.ts",
    "../../src/types/simple-peer-browser.d.ts"
  ]
}
