{
  "manifest_version": 3,
  "name": "Pboard",
  "version": "0.9.2",
  "description": "Keep a private, structured project state alongside AI conversations.",
  "permissions": ["storage", "menus", "clipboardWrite", "activeTab", "scripting", "identity", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "sidebar_action": {
    "default_title": "Pboard",
    "default_panel": "sidebar.html",
    "open_at_install": true
  },
  "page_action": {
    "default_title": "Pin current page to Pboard",
    "default_icon": "icons/pin.svg",
    "show_matches": ["http://*/*", "https://*/*"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "pin-selection-to-pboard": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Pin the selected text to Pboard"
    },
    "pin-page-to-pboard": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Pin the current web page to Pboard"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "project-board@local.invalid",
      "strict_min_version": "126.0"
    }
  }
}
